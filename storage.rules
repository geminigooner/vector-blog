rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null && request.auth.token.email == "ahatley094@gmail.com";
    }
    match /{allPaths=**} {
      allow read: if true; // Allows public to see images used in posts
      allow write: if isOwner() && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }
  }
}
